# =============================================================================
# 9jaRent.com.ng — Django Environment Configuration (EXAMPLE)
# =============================================================================
# This is a template. Copy to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================


# =============================================================================
# SECTION 1: CORE SECURITY (REQUIRED)
# =============================================================================

# Django secret key — generate a new one for production.
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-50-character-random-string

# DEBUG mode — MUST be False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:8000


# =============================================================================
# SECTION 2: DATABASE
# =============================================================================

# Development: SQLite, zero setup. Leave DATABASE_URL unset locally and it
# defaults to sqlite:///db.sqlite3.
#
# Production (DEBUG=False): PostgreSQL is REQUIRED - the app will refuse to
# start without a valid postgres:// DATABASE_URL when DEBUG=False (see
# nigerrents/settings.py). SQLite's single-writer file lock causes
# "database is locked" errors under real concurrent traffic, so it's fine
# for local dev but not for production, even on modest traffic.
#
# cPanel: use the "PostgreSQL Databases" panel to create a database + user
# the same way you would for MySQL, then set:
# DATABASE_URL=postgres://DBUSER:DBPASSWORD@localhost:5432/DBNAME
#
# After setting this, run once: python manage.py migrate
# DATABASE_URL=postgres://user:password@localhost:5432/9jarent


# =============================================================================
# SECTION 2B: CACHE (used for dashboard metrics, OTP resend cooldown, etc.)
# =============================================================================

# No Redis/Celery in this stack. In production the app uses Django's
# database-backed cache (see CACHES in settings.py) - one extra table, no
# extra service to run on cPanel. Create the table once after your first
# deploy (and again if you ever drop/recreate the database):
#   python manage.py createcachetable
# Nothing to set here - this section exists purely as a deployment reminder.


# =============================================================================
# SECTION 3: EMAIL CONFIGURATION
# =============================================================================

# Development: console backend (prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP (Gmail example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=9jaRent <noreply@9jarent.com.ng>

# Used to build absolute links in emails sent from background/signal code
# that has no request object (e.g. notification emails). Set to your real
# domain in production, e.g. https://9jarent.com.ng
SITE_URL=http://localhost:8000


# =============================================================================
# SECTION 4: PROXY / RATE LIMITING
# =============================================================================

# Only set this to True if the app sits behind a proxy or load balancer that
# OVERWRITES (never appends to) the X-Forwarded-For header. On typical
# shared/cPanel hosting with no such proxy, leave this False - otherwise the
# rate limiter can be bypassed by a spoofed header.
TRUST_PROXY_HEADERS=False


# =============================================================================
# SECTION 5: WHATSAPP INTEGRATION
# =============================================================================

WHATSAPP_DEFAULT_MESSAGE=Hello, I'm interested in {title} located at {location} listed on 9jaRent.com.ng. Please let me know if it's still available.


# =============================================================================
# SECTION 6: HTTPS / SECURITY HEADERS (PRODUCTION ONLY)
# =============================================================================

# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True


# =============================================================================
# SECTION 7: LOGGING
# =============================================================================

DJANGO_LOG_LEVEL=INFO


# =============================================================================
# SECTION 8: OPTIONAL INTEGRATIONS (FUTURE USE)
# =============================================================================

# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple Sign-In
# APPLE_CLIENT_ID=your_apple_client_id
# APPLE_SECRET_KEY=your_apple_secret

# Paystack
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Flutterwave
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx

# Redis / Celery
# This project intentionally does NOT use Redis or Celery - see README.md
# "Background work without Celery" for how scheduled/background-ish tasks
# (OTP cleanup, etc.) are done with plain management commands + cron instead.

# Sentry
# SENTRY_DSN=https://xxxxxxxx@yyyyyyy.ingest.sentry.io/zzzzzzz


# =============================================================================
# SECTION 9: VIDEO UPLOAD VALIDATION (OPTIONAL SYSTEM DEPENDENCY)
# =============================================================================

# Property video uploads are validated with ffmpeg-python, which shells out
# to the `ffprobe` binary. Most cPanel/shared hosts do NOT have this
# installed and won't let you install system packages. If it's missing, the
# app degrades gracefully: file size/extension are still validated, but the
# codec/resolution check is skipped (and a warning is logged) rather than
# blocking every video upload. If you want the stricter check enforced,
# install ffmpeg on the server and this starts working automatically -
# no code changes needed.
