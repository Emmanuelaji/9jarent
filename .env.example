# 9jaRent.com.ng — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
#
# DEBUG=True  -> local development (SQLite, localhost, no HTTPS)
# DEBUG=False -> production (MySQL required, HTTPS hardening on)
# Email is always sent via SMTP — no console fallback.


# --- Core ---
SECRET_KEY=change-me-to-a-50-character-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
TRUST_PROXY_HEADERS=False


# --- Database ---
# Leave DATABASE_URL unset locally to use SQLite.
# Production requires: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=
# CONN_MAX_AGE=600


# --- Email (Gmail for development) ---
# Requires a Google App Password — https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on the account first.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=9jaRent <bonifaceaji32@gmail.com>


# --- Logging ---
DJANGO_LOG_LEVEL=INFO


# --- Production HTTPS (uncomment after verifying TLS end-to-end) ---
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True